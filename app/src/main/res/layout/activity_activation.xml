<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/accent"
        android:theme="@style/ThemeOverlay.Material3.Dark"
        app:navigationIcon="@drawable/ic_back"
        app:title="Ativar o NeuraVision"
        app:titleTextColor="#FFFFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Situação atual -->
            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#10253A"
                android:padding="14dp"
                android:text="Versão gratuita"
                android:textColor="#9FD7F5"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="1 · Envie este ID ao administrador"
                android:textColor="@color/accent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- ID do aparelho -->
            <TextView
                android:id="@+id/deviceId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/tile_border"
                android:fontFamily="monospace"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:padding="16dp"
                android:text="NV-····-····-····"
                android:textColor="#FFFFFF"
                android:textIsSelectable="true"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopy"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Copiar ID" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWhats"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#25D366"
                    android:text="Enviar no WhatsApp"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="O administrador gera um código de ativação com a validade da sua licença."
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <!-- Código -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="2 · Cole o código de ativação"
                android:textColor="@color/accent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/tile_border"
                android:gravity="top"
                android:hint="NVL-..."
                android:inputType="textMultiLine|textNoSuggestions"
                android:minLines="3"
                android:padding="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="@color/muted"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnActivate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:backgroundTint="@color/accent"
                android:paddingVertical="12dp"
                android:text="Ativar aplicativo"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Dúvidas? Fale com o suporte NeuraVision pelo WhatsApp (21) 98775-4974."
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
